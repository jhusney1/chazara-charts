# API requests go through the CRA dev proxy in src/setupProxy.js, which
# forwards /api to the Express server. Do NOT set REACT_APP_API_URL here:
# it is read by browser code, so a Docker-internal hostname like
# http://api-dev:3001 cannot be resolved and it also bypasses the proxy.
#
# To point the proxy somewhere other than localhost:3001, set API_PROXY_TARGET
# (read by the dev server, not the browser).

# Needed when the dev server is reached via a non-localhost hostname.
DANGEROUSLY_DISABLE_HOST_CHECK=true
