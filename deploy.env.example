# Copy to deploy.env (gitignored) and fill in. Used by scripts/release.sh.
# SSH target for the DigitalOcean Droplet (key-based auth, no password prompts).
DEPLOY_HOST=root@178.128.150.161
# Directory on the Droplet that contains docker-compose.yml.
DEPLOY_PATH=/root/chazara-charts
# Public URL the post-release smoke check hits (nginx + Let's Encrypt in front of port 3000).
PROD_URL=https://chazaracharts.com
